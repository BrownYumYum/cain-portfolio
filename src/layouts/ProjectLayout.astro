---
import Layout from './Layout.astro';

interface Props {
  frontmatter: {
    title?: string;
    description?: string;
    category?: string;
  };
}

const { frontmatter } = Astro.props;
const title = frontmatter?.title ?? 'Project case study';
const description = frontmatter?.description ?? 'An engineering and business systems project by Cain Macias.';
const category = frontmatter?.category ?? 'Systems & software';
---
<Layout title={`${title} | Cain Macias`} description={description}>
  <header class="site-header">
    <a class="site-name" href="/" aria-label="Cain Macias home">
      <span class="brand-mark">c<span>.</span></span> cain macias
    </a>
    <nav aria-label="Main navigation" class="site-nav">
      <a href="/projects" aria-current="page">work</a>
      <a href="/about">about</a>
      <a href="/gear">gear</a>
      <a class="nav-contact" href="mailto:cainmacias69@gmail.com">let’s talk <span aria-hidden="true">↗</span></a>
    </nav>
  </header>

  <div class="case-study-breadcrumb">
    <a href="/projects"><span aria-hidden="true">←</span> All projects</a>
    <span class="breadcrumb-divider" aria-hidden="true">/</span>
    <span>{category}</span>
  </div>

  <article class="case-study">
    <p class="case-study-kicker">CASE STUDY <span aria-hidden="true">/</span> {category}</p>
    <slot />
  </article>

  <aside class="case-study-next" aria-label="More projects">
    <div>
      <p class="case-study-kicker">KEEP EXPLORING</p>
      <h2>More work, more systems.</h2>
      <p>Explore other integrations, automation tools, and software projects.</p>
    </div>
    <a class="primary-link" href="/projects">View all projects <span aria-hidden="true">↗</span></a>
  </aside>

  <footer class="site-footer">
    <span>© 2026 Cain Macias</span>
    <span>made with curiosity in Texas</span>
    <div><a href="https://github.com/BrownYumYum" target="_blank" rel="noreferrer">GitHub ↗</a><a href="mailto:cainmacias69@gmail.com">Email ↗</a></div>
  </footer>
</Layout>
