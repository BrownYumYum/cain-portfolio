---
import Layout from './Layout.astro';

interface Props {
  frontmatter: {
    title?: string;
    description?: string;
    category?: string;
  };
}

const { frontmatter } = Astro.props;
const title = frontmatter?.title ?? 'Project case study';
const description = frontmatter?.description ?? 'An engineering and business systems project by Cain Macias.';
const category = frontmatter?.category ?? 'Systems & software';
---
<Layout title={`${title} | Cain Macias`} description={description}><div class="case-study-breadcrumb ref-reveal">
    <a href="/projects"><span aria-hidden="true">←</span> All projects</a>
    <span class="breadcrumb-divider" aria-hidden="true">/</span>
    <span>{category}</span>
  </div>

  <article class="case-study ref-reveal">
    <p class="case-study-kicker">CASE STUDY <span aria-hidden="true">/</span> {category}</p>
    <slot />
  </article>

  <aside class="case-study-next" aria-label="More projects">
    <div>
      <p class="case-study-kicker">KEEP EXPLORING</p>
      <h2>More work, more systems.</h2>
      <p>Explore other integrations, automation tools, and software projects.</p>
    </div>
    <a class="primary-link" href="/projects">View all projects <span aria-hidden="true">↗</span></a>
  </aside></Layout>
