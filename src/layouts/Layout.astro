---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Cain Anthony Macias — Systems & Software',
  description = 'Cain Anthony Macias is an operations-minded systems builder focused on enterprise integrations, automation, and practical software.',
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="me" href="https://www.linkedin.com/in/cain-macias-a69801306/" />
    <meta name="theme-color" content="#090d14" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-N9TGGQZ889"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-N9TGGQZ889');
    </script>
  </head>
  <body class="min-h-screen bg-zinc-950 text-zinc-300 antialiased">
    <main class="site-shell">
      <slot />
    </main>
  </body>
</html>
