<style>
  .site-forest-world {
    position: fixed; inset: 0; z-index: 0; overflow: hidden; pointer-events: none;
    background:
      radial-gradient(ellipse at 49% 11%, rgba(83,144,84,.23), transparent 42%),
      linear-gradient(180deg,#0b1b13 0%,#112b1e 42%,#213e2b 78%,#173321 100%);
  }
  .site-forest-atmosphere {
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse at 8% 42%, rgba(81,144,77,.17),transparent 43%),
      radial-gradient(ellipse at 95% 39%,rgba(111,155,82,.14),transparent 40%),
      repeating-linear-gradient(0deg,transparent 0 32px,rgba(188,211,147,.012) 32px 33px);
  }
  .site-forest-canopy {
    position:absolute; inset:0; width:100%; height:100%; opacity:.73;
    image-rendering:pixelated;
  }
  .site-forest-floor {
    position:absolute;bottom:0;left:50%;width:100%;min-width:840px;
    height:clamp(210px,36vh,370px);
    transform:translateX(-50%);
    -webkit-mask-image:linear-gradient(to bottom,transparent 0%,rgba(0,0,0,.42) 18%,#000 43%);
    mask-image:linear-gradient(to bottom,transparent 0%,rgba(0,0,0,.42) 18%,#000 43%);
    opacity:.88;
  }
  .site-forest-scene { display:block;width:100%;height:100%;image-rendering:pixelated; }
  .site-forest-legibility {
    position:absolute;inset:0;
    background:
      linear-gradient(90deg, rgba(8,25,15,.19),transparent 19%,transparent 81%,rgba(8,25,15,.19)),
      linear-gradient(180deg,rgba(6,21,13,.04),rgba(7,21,14,.07) 62%,rgba(7,21,14,.23));
  }
  .site-forest-firefly {
    position:absolute;width:4px;height:4px;background:#f0e7a4;
    box-shadow:0 0 12px 3px rgba(227,225,142,.17);
    opacity:.42;animation:site-firefly-float 7s steps(5,end) infinite;
  }
  .site-forest-firefly--one {top:21%;left:12%;animation-delay:-3s}
  .site-forest-firefly--two {top:42%;right:12%;animation-delay:-5s}
  .site-forest-firefly--three {top:73%;left:21%;animation-delay:-1s}
  .pixel-deer-head {transform-box:fill-box;transform-origin:4px 14px;animation:site-graze 7.2s steps(4,end) infinite}
  .pixel-rabbit-nibble {animation:site-nibble 2.6s steps(2,end) infinite}
  .pixel-fireflies {animation:site-firefly-float 4.5s steps(3,end) infinite}
  @keyframes site-graze {0%,18%,85%,100%{transform:rotate(0deg) translateY(0)}35%,67%{transform:rotate(13deg) translateY(6px)}}
  @keyframes site-nibble {0%,55%,100%{transform:translateY(0)}30%,75%{transform:translateY(3px)}}
  @keyframes site-firefly-float {0%,100%{opacity:.2;transform:translateY(0)}50%{opacity:.8;transform:translateY(-10px)}}
  :global(html[data-theme="light"]) .site-forest-world {
    background:radial-gradient(ellipse at 50% 8%,rgba(124,172,103,.22),transparent 46%),linear-gradient(180deg,#f3f4e6 0%,#e6eed9 57%,#dce9cb 100%);
  }
  :global(html[data-theme="light"]) .site-forest-canopy {opacity:.30;filter:saturate(.7)}
  :global(html[data-theme="light"]) .site-forest-floor {opacity:.19}
  :global(html[data-theme="light"]) .site-forest-legibility {background:linear-gradient(180deg,rgba(247,249,238,.18),rgba(242,246,227,.16))}
  :global(html[data-theme="light"]) .site-forest-firefly {opacity:.15}
  @media(max-width:650px){
    .site-forest-canopy {opacity:.43}
    .site-forest-floor {height:240px;min-width:840px}
    .site-forest-legibility {background:linear-gradient(180deg,rgba(6,21,12,.1),rgba(6,21,12,.2))}
    .site-forest-firefly--three{display:none}
  }
  @media(prefers-reduced-motion:reduce){
    .pixel-deer-head,.pixel-rabbit-nibble,.pixel-fireflies,.site-forest-firefly {animation:none}
  }
</style>