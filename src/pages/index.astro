---
import Layout from '../layouts/Layout.astro';

const projects = [
  { number: '01', name: 'JEANSRS.OPS', subtitle: 'ERP-connected operations platform with AI-assisted workflows', type: 'Enterprise systems', href: '/projects/jeansrs-ops', tools: [{ name: 'React', tone: 'blue' }, { name: 'TypeScript', tone: 'blue' }, { name: 'AI workflows', tone: 'mint' }] },
  { number: '02', name: 'Python automation & reconciliation', subtitle: 'Catalog matching, vendor pricing changes, and reporting', type: 'Automation', href: '/projects/python-automation-engine', tools: [{ name: 'Python', tone: 'blue' }, { name: 'ETL', tone: 'amber' }, { name: 'APIs', tone: 'blue' }] },
  { number: '03', name: 'Enterprise system migration', subtitle: 'Data transformation, quality checks, and system parity', type: 'Data engineering', href: '/projects/enterprise-migration', tools: [{ name: 'ERP', tone: 'amber' }, { name: 'Python', tone: 'blue' }, { name: 'Validation', tone: 'mint' }] },
  { number: '04', name: 'B2B ordering & fulfillment', subtitle: 'An account-based ordering application for institutions', type: 'Web applications', href: '/projects/b2b-ordering-platform', tools: [{ name: 'Django', tone: 'mint' }, { name: 'PostgreSQL', tone: 'violet' }, { name: 'AWS', tone: 'amber' }] },
];

const education = [
  { degree: 'MS in Computer Science', school: 'Texas A&M University–Corpus Christi', detail: 'In progress' },
  { degree: 'MBA, Business Analytics & Healthcare Administration', school: 'Texas A&M University–Corpus Christi', detail: '4.0 GPA · Expected 2027' },
  { degree: 'BAS, Management & Leadership', school: 'Del Mar College', detail: '2025 · Dean’s & President’s Lists' },
  { degree: 'AAS, Medical Laboratory Technology', school: 'Del Mar College', detail: '2024' },
];
---
<Layout title="Cain Macias — Business Systems Engineer" description="Enterprise integration, software engineering, and AI automation case studies by Cain Macias.">

  <section class="ref-hero ref-reveal" aria-labelledby="home-heading">
    <div class="ref-hero-copy">
      <p class="ref-overline"><span class="ref-online-dot"></span> BUSINESS SYSTEMS ENGINEER · TEXAS</p>
      <h1 id="home-heading">hello, Cain here<span class="ref-hero-cursor" aria-hidden="true">_</span></h1>
      <p class="ref-hero-lead">I build systems that connect the dots between <strong>people, data, and business operations.</strong></p>
      <p class="ref-hero-body">My work spans enterprise integrations, custom software, and AI-assisted automation. I enjoy solving the messy operational problems that don't fit neatly into one application.</p>
      <div class="ref-hero-actions">
        <a href="/projects" class="ref-button">Explore my work <span aria-hidden="true">↗</span></a>
        <a href="https://www.linkedin.com/in/cain-macias-a69801306/" target="_blank" rel="noopener noreferrer" class="ref-quiet-link">LinkedIn ↗</a>
        <a href="mailto:cainmacias69@gmail.com" class="ref-quiet-link">Email ↗</a>
      </div>
    </div>
    <figure class="ref-hero-photo">
      <div class="ref-photo-surround"><img src="/profile.jpg" alt="Cain Macias" width="280" height="320" loading="eager" decoding="async" /></div>
      <figcaption><span class="ref-online-dot"></span> building, learning, improving</figcaption>
    </figure>
  </section>

  <section class="ref-featured ref-reveal" aria-labelledby="featured-heading">
    <div class="ref-section-label"><span class="ref-label-line"></span> CURRENTLY BUILDING <span class="ref-label-right">FEATURED / 2026</span></div>
    <a href="/projects/jeansrs-ops" class="ref-featured-link">
      <div class="ref-featured-text">
        <span class="ref-featured-pill"><span class="ref-online-dot"></span> In development</span>
        <h2 id="featured-heading">JEANSRS.OPS <span aria-hidden="true">↗</span></h2>
        <p>A connected operations platform bringing together ERP data, manufacturer catalogs, customer workflows, and human-reviewed AI actions.</p>
        <div class="ref-tags" aria-label="Featured project technologies"><span class="tech-pill tech-pill--amber">Epicor Eclipse</span><span class="tech-pill tech-pill--blue">React + TypeScript</span><span class="tech-pill tech-pill--violet">API integrations</span><span class="tech-pill tech-pill--mint">AI workflows</span></div>
        <span class="ref-read-more">Read the technical case study <span aria-hidden="true">→</span></span>
      </div>
      <div class="ref-system-art" aria-hidden="true">
        <div class="ref-system-label">SYSTEM FLOW / SIMPLIFIED</div>
        <div class="ref-system-upstream"><span>ERP</span><span>Catalogs</span><span>CRM</span></div>
        <div class="ref-system-traces"><i></i><i></i><i></i></div>
        <div class="ref-system-core"><small>OPERATIONS HUB</small><strong>JEANSRS.OPS</strong><small>integrate · validate · review</small></div>
        <div class="ref-system-traces"><i></i><i></i><i></i></div>
        <div class="ref-system-upstream ref-system-downstream"><span>Pricing</span><span>Reports</span><span>Agents</span></div>
        <div class="ref-system-foot"><span class="ref-online-dot"></span> Human decisions stay in the loop</div>
      </div>
    </a>
  </section>

  <section class="ref-simple-section ref-reveal" aria-labelledby="projects-heading">
    <div class="ref-section-label"><span class="ref-label-line"></span> SELECTED PROJECTS <span class="ref-label-right">01 — 04</span></div>
    <div class="ref-section-heading">
      <h2 id="projects-heading">things I've worked on</h2>
      <a href="/projects" class="ref-text-link">View all projects <span aria-hidden="true">↗</span></a>
    </div>
    <div class="ref-work-list">
      {projects.map(project => (
        <a href={project.href} class="ref-work-row">
          <span class="ref-work-number">{project.number}</span>
          <span class="ref-work-content">
            <span class="ref-work-name">{project.name}</span>
            <span class="ref-work-desc">{project.subtitle}</span>
            <span class="ref-work-technologies" aria-label="Technologies">{project.tools.map((tool) => <span class={`tech-pill tech-pill--${tool.tone}`}>{tool.name}</span>)}</span>
          </span>
          <span class="ref-work-type">{project.type}</span>
          <span class="ref-work-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="ref-simple-section ref-reveal" aria-labelledby="education-heading">
    <div class="ref-section-label"><span class="ref-label-line"></span> EDUCATION <span class="ref-label-right">CONTINUING TO LEARN</span></div>
    <div class="ref-section-heading">
      <h2 id="education-heading">a little more about my background</h2>
      <a href="/about#education-title" class="ref-text-link">More about me <span aria-hidden="true">↗</span></a>
    </div>
    <div class="ref-education-list">
      {education.map(item => (
        <div class="ref-education-row">
          <div><h3>{item.degree}</h3><span>{item.school}</span></div>
          <span class="ref-education-year">{item.detail}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="ref-end-note ref-reveal">
    <p>Have a workflow that needs untangling?</p>
    <a href="mailto:cainmacias69@gmail.com">Let's talk systems <span aria-hidden="true">↗</span></a>
  </section>
</Layout>
