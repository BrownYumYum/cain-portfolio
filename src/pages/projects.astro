---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Projects | Cain Anthony Macias">
  <nav class="flex items-center justify-between py-6 mb-12 border-b border-zinc-800/60">
    <a href="/" class="font-semibold text-white tracking-tight flex items-center gap-2">
      <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block"></span>
      Cain Macias
    </a>
    <div class="flex items-center gap-5 text-sm text-zinc-400 font-medium">
      <a href="/" class="hover:text-white transition-colors">Home</a>
      <a href="/projects" class="text-white transition-colors">Projects</a>
      <a href="/gear" class="hover:text-white transition-colors">Gear</a>
      <a href="/about" class="hover:text-white transition-colors">About</a>
      <a href="mailto:cainmacias69@gmail.com" class="hover:text-white transition-colors">Contact</a>
    </div>
  </nav>

  <header class="mb-12">
    <h1 class="text-3xl sm:text-4xl font-bold text-white mb-3">Projects & Systems</h1>
    <p class="text-zinc-400">Enterprise software platforms, automation pipelines, and production toolsets.</p>
  </header>

  <div class="space-y-8">
    <!-- JEANSRS.OPS (New Featured Project) -->
    <div class="bg-zinc-900/60 border border-zinc-800 p-6 rounded-2xl hover:border-zinc-700 transition-all">
      <div class="flex items-center justify-between gap-4 mb-2">
        <h2 class="text-xl font-bold text-white">JEANSRS.OPS — Central Operations & AI Hub</h2>
        <span class="font-mono text-xs text-emerald-400 bg-emerald-950/40 border border-emerald-800/40 px-2.5 py-1 rounded-full">Active Production</span>
      </div>
      <p class="text-sm text-zinc-400 leading-relaxed mb-4">
        Unified enterprise integration platform connecting Epicor Eclipse ERP with AutoQuotes pricing sync, federal GSA MAS compliance reporting, HubSpot CRM, XPO/Eniture logistics, and autonomous AI agents powered by Claude with human-in-the-loop approvals.
      </p>
      <div class="flex flex-wrap gap-2 font-mono text-xs mb-4">
        <span class="bg-zinc-800 text-zinc-300 px-2.5 py-1 rounded">Python</span>
        <span class="bg-zinc-800 text-zinc-300 px-2.5 py-1 rounded">Node.js</span>
        <span class="bg-zinc-800 text-zinc-300 px-2.5 py-1 rounded">Epicor Eclipse ERP</span>
        <span class="bg-zinc-800 text-zinc-300 px-2.5 py-1 rounded">Claude AI Gateway</span>
      </div>
    </div>

    <!-- Real-Time Intelligence Dashboard (Fixed Link) -->
    <div class="bg-zinc-900/60 border border-zinc-800 p-6 rounded-2xl hover:border-zinc-700 transition-all">
      <div class="flex items-center justify-between gap-4 mb-2">
        <h2 class="text-xl font-bold text-white">Real-Time Intelligence Dashboard</h2>
        <span class="font-mono text-xs text-blue-400 bg-blue-950/40 border border-blue-800/40 px-2.5 py-1 rounded-full">AWS Cloud</span>
      </div>
      <p class="text-sm text-zinc-400 leading-relaxed mb-4">
        AWS-hosted centralized intelligence hub designed for live inventory monitoring and automated pricing parity alerts across database endpoints.
      </p>
      <div class="flex flex-wrap gap-2 font-mono text-xs">
        <span class="bg-zinc-800 text-zinc-300 px-2.5 py-1 rounded">Django</span>
        <span class="bg-zinc-800 text-zinc-300 px-2.5 py-1 rounded">AWS EC2</span>
        <span class="bg-zinc-800 text-zinc-300 px-2.5 py-1 rounded">REST API</span>
      </div>
    </div>
  </div>
</Layout>
